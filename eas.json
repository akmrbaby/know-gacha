{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "map-lab": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_GRAPH_LAB": "1"
      },
      "channel": "map-lab"
    }
  },
  "submit": {
    "production": {}
  }
}
