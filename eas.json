{
  "cli": {
    "version": ">= 27.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "map-lab": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_GRAPH_LAB": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
