{
  "expo": {
    "name": "KnowGacha ― 脳ガチャ ―",
    "slug": "know-gacha",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akmrbaby.knowgacha",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#DCE9E2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "knowgacha",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#DCE9E2",
          "image": "./assets/splash-icon.png",
          "imageWidth": 256,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#DCE9E2",
            "image": "./assets/splash-icon.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ja",
            "en"
          ],
          "supportsRTL": false,
          "forcesRTL": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "4afd09c4-14e2-4b76-abf7-a610d9a3f2ef"
      }
    },
    "owner": "akmrbaby",
    "updates": {
      "url": "https://u.expo.dev/4afd09c4-14e2-4b76-abf7-a610d9a3f2ef"
    }
  }
}
